rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read, write: if request.auth != null;

      // Optional: ensure sharedWithUserIds is an array
      allow update: if request.auth != null && request.resource.data.keys().hasOnly(['sharedWithUserIds', 'updatedAt']);
    }
  }
}
